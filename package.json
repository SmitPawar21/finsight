{
  "name": "finsight",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "dev:api": "pnpm --filter @finsight/api dev",
    "stack:up": "docker compose up -d --wait",
    "stack:up:obs": "docker compose --profile observability up -d --wait",
    "stack:ps": "docker compose --profile observability ps -a",
    "stack:logs": "docker compose --profile observability logs -f --tail=100",
    "stack:down": "docker compose --profile observability down",
    "stack:reset": "docker compose --profile observability down -v",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest --project unit"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "devDependencies": {
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  }
}
